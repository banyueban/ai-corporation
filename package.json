{
  "name": "ai-corporation-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop runtime for AI Corporation.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.65.0"
  },
  "scripts": {
    "build": "pnpm --recursive run build && cargo build --workspace",
    "build:rust": "cargo build --workspace",
    "build:rust:release": "cargo build --workspace --release",
    "check": "pnpm check:status && pnpm check:task-units && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:rust && pnpm rust:fmt && pnpm rust:clippy && pnpm secret:scan",
    "check:status": "node scripts/check-project-status.mjs",
    "check:task-units": "node scripts/check-task-units.mjs",
    "format": "prettier --write \"**/*.{js,mjs,json,ts,tsx,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,ts,tsx,css,yaml,yml}\"",
    "lint": "eslint .",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:fmt": "cargo fmt --all --check",
    "secret:scan": "node scripts/secret-scan.mjs",
    "test": "node --test scripts/check-project-status.test.mjs scripts/check-task-units.test.mjs scripts/check-closure-scope.test.mjs && pnpm --recursive run test",
    "test:e2e": "pnpm --filter @ai-corporation/desktop test:e2e",
    "test:rust": "cargo test --workspace",
    "typecheck": "pnpm --recursive run typecheck"
  }
}
