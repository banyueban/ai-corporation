{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist/electron",
    "rootDir": "src",
    "target": "ES2022",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": ["src/**/*.test.ts"],
  "include": [
    "src/main/**/*.ts",
    "src/main/**/*.d.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
