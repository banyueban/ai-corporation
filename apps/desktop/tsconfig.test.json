{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ES2022",
    "types": ["node", "vitest"]
  },
  "include": [
    "e2e/**/*.ts",
    "playwright.config.ts",
    "src/**/*.test.ts",
    "src/main/native-core-path.ts",
    "src/main/window-options.ts",
    "vitest.config.ts"
  ]
}
